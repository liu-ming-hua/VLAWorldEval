{
  "schema_version": 1,
  "environment": "world_models.irasim",
  "module": "adapters.world_models.irasim",
  "adapter": "IRASimAdapter",
  "kwargs": {
    "repo_path": {"project_path": "third_party/irasim"},
    "checkpoint_path": {"project_path": "checkpoints/world_models/irasim/languagetable_frame_ada.pt"},
    "vae_model_path": {"project_path": "checkpoints/world_models/irasim/sdxl_vae"},
    "num_inference_steps": 50
  },
  "gpus": [0],
  "memory_gib": 20,
  "seed": 3407,
  "action": {
    "dimension": 2,
    "horizon": 15,
    "representation": "xy",
    "frame": "languagetable_native_dataset_tick_presentation_clock",
    "semantics": "delta_translation",
    "rate_hz": 4,
    "normalization": "raw_metric_adapter_multiplies_20",
    "temporal_layout": "future"
  },
  "video": {"fps": 4, "frames_per_chunk": 15, "temporal_layout": "future"},
  "output_views": ["primary"],
  "reset_operation": "reset",
  "instruction_conditioning": false,
  "worker_options": {
    "startup_timeout_seconds": 900,
    "request_timeout_seconds": 1800,
    "shutdown_grace_seconds": 30
  }
}
