{
  "schema_version": 1,
  "environment": "world_models.iws",
  "module": "adapters.world_models.iws",
  "adapter": "IWSAdapter",
  "kwargs": {
    "checkpoint_path": {"project_path": "checkpoints/world_models/iws/pusht_cam1/checkpoints/best.ckpt"},
    "repo_path": {"project_path": "third_party/iws"},
    "device": "cuda:0"
  },
  "gpus": [0],
  "memory_gib": 4,
  "seed": 0,
  "action": {
    "dimension": 4,
    "horizon": 1,
    "representation": "bimanual_xy",
    "frame": "aloha_world",
    "semantics": "absolute_eef_position",
    "rate_hz": 10,
    "normalization": "raw_metres_adapter_checkpoint_normalizes_clamps",
    "components": ["left_x", "left_y", "right_x", "right_y"],
    "temporal_layout": "future"
  },
  "video": {"fps": 10, "frames_per_chunk": 1, "temporal_layout": "future"},
  "output_views": ["camera_1_color"],
  "reset_operation": "reset",
  "instruction_conditioning": false,
  "worker_options": {
    "startup_timeout_seconds": 180,
    "request_timeout_seconds": 120,
    "shutdown_grace_seconds": 30
  }
}
