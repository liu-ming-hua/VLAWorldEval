{
  "schema_version": 1,
  "suite_id": "pilworld_groot_n17_ctrl_v1",
  "pair_manifest": "configs/pairs/groot_n17__ctrl_world.json",
  "dataset": {
    "root": "datasets/cosmos3_droid/success",
    "episodes": [
      0
    ],
    "start_frame": 30,
    "fps": 15,
    "tail_policy": "drop_incomplete_chunk"
  },
  "runtime": {
    "vla_environment": "vla.groot_n17",
    "world_model_environment": "world_models.ctrl_world",
    "vla_gpus": [
      1
    ],
    "world_model_gpus": [
      1
    ],
    "vla_memory_gib": 20,
    "world_model_worker_options": {
      "shutdown_grace_seconds": 30
    },
    "execution": "persistent_isolated_workers",
