    "max_process_memory_gib_per_gpu": 32,
    "world_model_checkpoint": "checkpoints/world_models/ctrl_world/ctrl_world/checkpoint-10000.pt"
  },
  "sampling": {
    "num_inference_steps": 50,
    "guidance": 1,
    "shift": 1,
    "image_size": 320,
    "resolution": "320x192",
    "diffusion_cache": false,
    "torch_compile": false
  },
  "seeds": [
    0
  ],
  "output_root": "results/experiments/pilworld_groot_n17_ctrl_v1",
  "experiments": [
    {
      "id": "pilworld_smoke",
      "mode": "pilworld",
      "action_source": "vla",
      "state_provider": "pilworld_action_target",
      "chunks": 2
    },
    {
      "id": "pilworld_long",
      "mode": "pilworld",
      "action_source": "vla",
      "state_provider": "pilworld_action_target",
      "chunks": 20
    }
  ],
  "metadata": {
    "evaluation_protocol": "PiL-World-style absolute terminal-action state feedback",
    "pilworld_model_adapter_loaded": false,
    "paper_reproduction": false
  }
}
